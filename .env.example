# schema=public is required by the Prisma CLI against the embedded @prisma/dev PGlite
# server: without it `prisma migrate` cannot see its own migration history table.
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable&schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:51215/template1?sslmode=disable&schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
AI_PROVIDER="apmix"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
UPLOAD_DIR="./uploads"
DEMO_MODE="true"
ALLOW_DEMO_RESET="false"