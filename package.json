{
  "name": "campusgig",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "node scripts/test-db.mjs -- vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "verify:aggregates": "tsx scripts/verify-aggregates.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-auth": "4.24.15",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1",
    "bcryptjs": "3.0.3",
    "zod": "4.6.5",
    "lucide-react": "1.49.0",
    "server-only": "0.0.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@prisma/dev": "0.24.17",
    "prisma": "7.10.0",
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "tsx": "4.23.15"
  }
}